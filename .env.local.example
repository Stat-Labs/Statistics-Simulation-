# ─────────────────────────────────────────────────────────────
# StatLab Environment Variables
# Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── AI providers (platform defaults) ─────────────────────────
# At least ONE is recommended. Groq + Mistral are the defaults.
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
DEEPSEEK_API_KEY=
# Optional platform-level OpenAI / Claude (BYOK users bring their own instead)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Auth ─────────────────────────────────────────────────────
# At least 32 characters. Generate: openssl rand -base64 32
AUTH_SECRET=

# ── Database ─────────────────────────────────────────────────
# Production (Render): postgres://user:pass@host:5432/dbname
# Leave blank for local development → uses SQLite at db/statlab.sqlite
DATABASE_URL=
# Optional explicit override: pg | sqlite
DB_DRIVER=

# ── Object storage (S3-swappable) ────────────────────────────
# cloudinary (default) | s3 (future) | local (dev, no external keys)
# Use `local` for local development — files land in ./storage/.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Only used with STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage

# ── Secret encryption (BYOK keys at rest) ────────────────────
# 32-byte key, base64. Generate: openssl rand -base64 32
# REQUIRED in production. Local dev falls back to a dev key.
ENCRYPTION_MASTER_KEY=

# ── Python backend (FastAPI) for statistical computation ─────
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# ── Retention (free tier) ─────────────────────────────────────
# Raw datasets are deleted after knowledge extraction by default.
# Set to true to keep raw files permanently (paid tier).
RETAIN_RAW_DATASETS=false

# ── Frontend public URL (for invite links, etc.) ─────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
