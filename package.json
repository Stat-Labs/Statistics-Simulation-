{
  "name": "statslab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:migrate",
    "dev": "next dev",
    "dev:backend": "uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config=drizzle.config.sqlite.ts && drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.sqlite.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "cloudinary": "^2.10.0",
    "csv-parse": "^7.0.0",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.43.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "ml-logistic-regression": "^2.0.0",
    "ml-random-forest": "^2.1.0",
    "ml-regression": "^6.3.0",
    "next": "14.2.35",
    "papaparse": "^5.5.4",
    "postgres": "^3.4.9",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.9.0",
    "simple-statistics": "^7.8.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/html2canvas": "^0.5.35",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
